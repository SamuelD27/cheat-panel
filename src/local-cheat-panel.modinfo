<?xml version="1.0" encoding="utf-8"?>
<Mod id="local-cheat-panel" version="1" xmlns="ModInfo">
	<Properties>
		<Name>LOC_LCP_NAME</Name>
		<Description>LOC_LCP_DESCRIPTION</Description>
		<Authors>Local</Authors>
		<Package>Mod</Package>
		<AffectsSavedGames>0</AffectsSavedGames>
		<EnabledByDefault>1</EnabledByDefault>
		<!-- Private solo-play cheat/sandbox panel. Forked (privately, not for redistribution) from the
		     Sovereign Cheat Panel, which is proven working on Civ VII build 23245653 / Update 1.4.0
		     "Test of Time". M0 = faithful rebranded fork. New features (per-row unit/city lists, map
		     paint, infinite-move toggle, duplication) are added in later milestones. -->
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="shell-local-cheat-panel" scope="shell" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>database/input.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="game-local-cheat-panel" scope="game" criteria="always">
			<Actions>
				<!-- DO NOT register database/input.xml here (game scope). input.xml defines rows in
				     InputActions / InputActionDefaultGestures, which exist only in the FRONT-END
				     (shell) input database — NOT the gameplay database. A game-scope <UpdateDatabase>
				     on it fails to load ("Error Loading XML … require a rollback"), and the engine
				     then performs a COMPLETE rollback to vanilla, so NO save can be loaded while this
				     mod is enabled (clicking "Continue Game" bounces back to the main menu). The F8
				     binding therefore lives ONLY in the shell-scope group above; in-game, open the
				     panel with the dock skull button. (Regression introduced in M4.1 / bdafc56,
				     reverted here. A correct in-game F8 needs a JS-level approach, tracked separately.) -->
				<UpdateDatabase>
					<!-- Registers INTERFACEMODE_LCP_CLAIM_TILE in the gameplay InterfaceModes table so
					     InterfaceMode.switchTo accepts it. InterfaceModes IS a gameplay-scope table
					     (base-standard/data/interface-modes.xml loads in game scope), so this is safe. -->
					<Item>database/interface-modes.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/Cheat-Panel-Text.sql</Item>
				</UpdateText>
				<UIScripts>
					<Item>ui/sub-system-dock/lcp-sub-system-dock.js</Item>
					<Item>ui/cheat-panel/cheat-panel.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/cheat-panel/cheat-panel.html</Item>
					<Item>ui/cheat-panel/shared/imports.js</Item>
					<Item>ui/cheat-panel/shared/api.js</Item>
					<Item>ui/cheat-panel/shared/infinite-move.js</Item>
					<Item>ui/cheat-panel/tab-units.js</Item>
					<Item>ui/cheat-panel/tab-cities.js</Item>
					<Item>ui/cheat-panel/claim-tile-mode.js</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText>
		<File>text/en_us/ModuleText.xml</File>
	</LocalizedText>
</Mod>
